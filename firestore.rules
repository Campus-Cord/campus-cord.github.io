rules_version = '2';
// CampusCord security rules (v3.11: photo avatars, badge showcase, voice channels, Sparks shop, private rooms, timeouts). Published automatically by GitHub Actions when this file changes.
// Paste all of this into Firebase console -> Firestore Database -> Rules, then click Publish.
service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() { return request.auth != null; }
    function cfgPath() { return /databases/$(database)/documents/config/main; }
    function cfg() { return get(cfgPath()).data; }
    function isOwner() { return signedIn() && exists(cfgPath()) && cfg().ownerUid == request.auth.uid; }
    function notBanned() { return !(request.auth.uid in cfg().get('banned', [])); }
    function isMember() {
      return signedIn() && exists(cfgPath()) && notBanned()
        && exists(/databases/$(database)/documents/members/$(request.auth.uid));
    }
    // Owner, or a member the owner made a developer.
    // Developers; temporary ones (devUntil) lose their powers when the time runs out.
    function isAdmin() { return isOwner() || (isMember() && request.auth.uid in cfg().get('admins', [])
      && (!(request.auth.uid in cfg().get('devUntil', {})) || cfg().devUntil[request.auth.uid] > request.time.toMillis())); }
    // Head developers (config.headDevs, set by the owner): developers with extra powers.
    function isHeadDev() { return isAdmin() && request.auth.uid in cfg().get('headDevs', []); }
    function ownsNew() { return request.resource.data.uid == request.auth.uid; }
    function ownsOld() { return resource.data.uid == request.auth.uid; }
    function changed() { return request.resource.data.diff(resource.data).affectedKeys(); }
    // Real-name strikes: the owner can flag a name; the person can't post until they change it.
    function nameLocked() { let f = cfg().get('nameFlags', {}).get(request.auth.uid, null);
      return f != null && f.get('active', false) && f.at > get(/databases/$(database)/documents/members/$(request.auth.uid)).data.get('nickAt', 0); }
    // Unique names: names/{lowercased name} says who owns each name.
    function nameKey(n) { return n.lower().replace('/', '_'); }
    function nameMine(n) { return exists(/databases/$(database)/documents/names/$(nameKey(n)))
      && get(/databases/$(database)/documents/names/$(nameKey(n))).data.uid == request.auth.uid; }
    function notTimedOut() { return !(request.auth.uid in cfg().get('timeouts', {})) || cfg().timeouts[request.auth.uid] < request.time.toMillis(); }

    // ---------------- server settings
    match /config/main {
      allow read: if signedIn();
      allow create: if signedIn() && !exists(cfgPath())
        && request.resource.data.ownerUid == request.auth.uid
        && request.resource.data.get('banned', []) is list;
      allow update: if isOwner() && request.resource.data.ownerUid == resource.data.ownerUid;
      // Developers can only kick/unban/time out, never the owner or another developer.
      allow update: if isAdmin() && !isOwner()
        && changed().hasOnly(['banned', 'bannedNames', 'timeouts', 'bannedDevices', 'bannedDevNames', 'banReasons'])
        && !(resource.data.ownerUid in request.resource.data.get('banned', []))
        && !request.resource.data.get('banned', []).hasAny(resource.data.get('admins', []))
        && !(resource.data.ownerUid in request.resource.data.get('timeouts', {}))
        && !request.resource.data.get('timeouts', {}).keys().hasAny(resource.data.get('admins', []));
    // Head developers can also make/remove developers and moderate developers, but never the owner or a head developer,
    // and they can't change who is a head developer.
    allow update: if isHeadDev() && !isOwner()
        && changed().hasOnly(['banned', 'bannedNames', 'timeouts', 'bannedDevices', 'bannedDevNames', 'banReasons', 'admins', 'devUntil'])
        && !(resource.data.ownerUid in request.resource.data.get('banned', []))
        && !request.resource.data.get('banned', []).hasAny(resource.data.get('headDevs', []))
        && !(resource.data.ownerUid in request.resource.data.get('timeouts', {}))
        && !request.resource.data.get('timeouts', {}).keys().hasAny(resource.data.get('headDevs', []))
        && request.resource.data.get('admins', []) is list
        && request.resource.data.get('admins', []).hasAll(resource.data.get('headDevs', []))
        && !request.resource.data.get('devUntil', {}).diff(resource.data.get('devUntil', {})).affectedKeys().hasAny(resource.data.get('headDevs', []));
      // Designers can change only the logo (serverIcon), and only a short one.
      allow update: if isMember() && request.auth.uid in cfg().get('designers', [])
        && changed().hasOnly(['serverIcon'])
        && request.resource.data.serverIcon is string
        && request.resource.data.serverIcon.size() >= 1 && request.resource.data.serverIcon.size() <= 16;
    }
    // Shop prices + Stripe payment links: everyone reads, only the owner edits.
    match /config/shop {
      allow read: if signedIn();
      allow write: if isOwner();
    }
    // Public key for push notifications (written by the Notify GitHub Action).
    match /config/push {
      allow read: if signedIn();
    }
    // Push subscriptions: each person manages their own devices and notification choices. Only the sender (server) reads them all.
    match /push/{uid} {
      allow read, write: if signedIn() && uid == request.auth.uid;
      match /subs/{sid} {
        allow read, write: if signedIn() && uid == request.auth.uid;
      }
    }
    // Sparks prices + quest rewards (written by the owner's app) so purchases can be checked here.
    match /config/catalog {
      allow read: if signedIn();
      allow write: if isOwner();
    }

    // Feedback board: members post bugs/ideas and vouch (one vouch each, only their own). Owner/devs set status + reply.
    match /feedback/{fid} {
      allow read: if isMember();
      allow create: if isMember() && ownsNew() && notTimedOut()
        && request.resource.data.keys().hasOnly(['uid', 'nick', 'type', 'title', 'text', 'ts', 'votes', 'status'])
        && request.resource.data.status == 'open' && request.resource.data.votes == [request.auth.uid]
        && request.resource.data.title is string && request.resource.data.title.size() <= 80
        && request.resource.data.text is string && request.resource.data.text.size() <= 1000;
      allow update: if isMember() && changed().hasOnly(['votes'])
        && request.resource.data.votes.toSet().difference(resource.data.votes.toSet()).union(resource.data.votes.toSet().difference(request.resource.data.votes.toSet())) == [request.auth.uid].toSet();
      allow update: if isAdmin() && changed().hasOnly(['status', 'statusBy', 'statusAt', 'reply', 'replyBy', 'replyAt']);
      allow delete: if isAdmin() || (isMember() && resource.data.uid == request.auth.uid);
    }

    match /secret/invite {
      allow read, update: if isAdmin();
      allow create: if signedIn()
        && getAfter(cfgPath()).data.ownerUid == request.auth.uid
        && (!exists(/databases/$(database)/documents/secret/invite) || isOwner());
    }

    // ---------------- people
    // Vouch tries: 4 each; only the owner can add "extra". A person can only count one more try,
    // and only together with the vouch it's for (see vouchTryOk in rooms/msgs).
    match /vouchQuota/{uid} {
      function forRealVouch() {
        let p = request.resource.data.lastMsg.split('/');
        let m = /databases/$(database)/documents/rooms/$(p[0])/msgs/$(p[1]);
        return existsAfter(m) && !exists(m) && getAfter(m).data.uid == request.auth.uid && ('vouch' in getAfter(m).data);
      }
      allow read: if signedIn() && (uid == request.auth.uid || isOwner());
      allow write: if isOwner();
      allow create: if signedIn() && uid == request.auth.uid
        && request.resource.data.keys().hasOnly(['used', 'lastMsg']) && request.resource.data.used == 1 && forRealVouch();
      allow update: if signedIn() && uid == request.auth.uid
        && changed().hasOnly(['used', 'lastMsg']) && request.resource.data.used == resource.data.get('used', 0) + 1 && forRealVouch();
    }
    // Strikes, warnings, suspensions: only the owner gives them. The person can read their own
    // and can only mark a notice as read ("I understand"), once.
    match /mod/{uid} {
      allow read: if signedIn() && (uid == request.auth.uid || isOwner());
      allow write: if isOwner();
      match /notices/{nid} {
        allow read: if signedIn() && (uid == request.auth.uid || isOwner());
        allow create, update, delete: if isOwner();
        // Head developers can send warnings (not strikes) to anyone except the owner and other head developers.
        allow create: if isHeadDev() && uid != cfg().ownerUid && !(uid in cfg().get('headDevs', []))
          && request.resource.data.keys().hasOnly(['kind', 'reason', 'at', 'by', 'ackAt'])
          && request.resource.data.kind == 'warning' && request.resource.data.by == request.auth.uid && request.resource.data.ackAt == null;
        allow update: if signedIn() && uid == request.auth.uid && resource.data.ackAt == null
          && changed().hasOnly(['ackAt']) && request.resource.data.ackAt is int;
      }
    }
    // Easy changes from the Dev panel: developers send an AI's answer; the robot tests it;
    // only the owner can approve or turn it down. Nobody but the owner and the sender can read it.
    match /devSubs/{id} {
      allow read: if isOwner() || isHeadDev() || (signedIn() && resource.data.uid == request.auth.uid);
      allow create: if isAdmin() && request.resource.data.keys().hasOnly(['uid', 'nick', 'title', 'answer', 'ts', 'status'])
        && request.resource.data.uid == request.auth.uid && request.resource.data.status == 'new'
        && request.resource.data.title is string && request.resource.data.title.size() >= 1 && request.resource.data.title.size() <= 100
        && request.resource.data.answer is string && request.resource.data.answer.size() <= 300000
        && request.resource.data.ts is int;
      // The owner decides; head developers can too, except changes that touch payments/owner stuff (flags).
      allow update: if (isOwner() || (isHeadDev() && resource.data.get('flags', []).size() == 0)) && changed().hasOnly(['status', 'decidedAt'])
        && ((resource.data.status == 'ready' && request.resource.data.status in ['approved', 'rejecting'])
          || (resource.data.status in ['new', 'failed'] && request.resource.data.status == 'rejecting'));
      allow delete: if isOwner() || (signedIn() && resource.data.uid == request.auth.uid
        && resource.data.status in ['new', 'failed', 'error', 'rejected', 'live']);
    }
    // Site changes: the owner approves or turns down a pull request by number; the merge.yml
    // GitHub Action (service account) does the merge and records the result. Devs can see status.
    match /devApprovals/{n} {
      allow read: if isAdmin();
      allow create, update: if isOwner()
        && request.resource.data.keys().hasOnly(['sha', 'status', 'title', 'by', 'at'])
        && request.resource.data.status in ['queued', 'rejecting']
        && request.resource.data.sha is string && request.resource.data.sha.matches('^[0-9a-f]{40}$')
        && request.resource.data.by == request.auth.uid;
      allow delete: if isOwner();
    }
    // Ban appeals: a banned person can open their own appeal and submit answers once, within 30 minutes. Owner decides.
    match /appeals/{uid} {
      function isBannedHere() { return request.auth.uid in cfg().get('banned', [])
        || request.resource.data.get('dev', resource == null ? '' : resource.data.get('dev', '')) in cfg().get('bannedDevices', []); }
      allow read: if signedIn() && (uid == request.auth.uid || isOwner());
      allow create: if signedIn() && uid == request.auth.uid && isBannedHere()
        && request.resource.data.keys().hasOnly(['startedAt', 'nick', 'dev', 'status', 'answers', 'submittedAt'])
        && request.resource.data.startedAt <= request.time.toMillis() + 60000 && request.resource.data.startedAt >= request.time.toMillis() - 60000
        && request.resource.data.get('status', 'pending') == 'pending';
      allow update: if signedIn() && uid == request.auth.uid
        && !('submittedAt' in resource.data) && changed().hasOnly(['answers', 'submittedAt'])
        && request.time.toMillis() <= resource.data.startedAt + 1800000 + 60000;
      allow update, delete: if isOwner();
    }
    match /names/{n} {
      allow read: if signedIn();
      allow create: if signedIn() && request.resource.data.keys().hasOnly(['uid', 'ts'])
        && (request.resource.data.uid == request.auth.uid || isOwner());
      allow update: if isOwner();
      allow delete: if signedIn() && (resource.data.uid == request.auth.uid || isOwner());
    }
    // Signed member agreements (with a drawn signature). Only the owner and the signer can read them.
    match /signatures/{uid} {
      allow read: if isOwner() || (signedIn() && uid == request.auth.uid);
      allow create, update: if signedIn() && uid == request.auth.uid && isMember()
        && request.resource.data.keys().hasOnly(['v', 'at', 'nick', 'typed', 'img', 'fullName', 'sigId'])
        && request.resource.data.fullName is string && request.resource.data.fullName.size() <= 60
        && request.resource.data.sigId is string && request.resource.data.sigId.size() <= 24
        && request.resource.data.v is int && request.resource.data.at is int
        && request.resource.data.typed is string && request.resource.data.typed.size() <= 200
        && request.resource.data.nick is string && request.resource.data.nick.size() <= 24
        && request.resource.data.img is string && request.resource.data.img.size() <= 80000
        && request.resource.data.img.matches('data:image/(jpeg|png);base64,.*');
      // The owner approves, or asks someone to sign again (redo + a short note).
      allow update: if isOwner() && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['approved', 'redo', 'redoNote', 'redoPart'])
        && request.resource.data.get('redo', false) is bool
        // one or more parts, like "signature" or "name,signature"
        && request.resource.data.get('redoPart', 'all').matches('^(all|(signature|name|statement)(,(signature|name|statement)){0,2})$') && request.resource.data.get('redoNote', '') is string
        && request.resource.data.get('redoNote', '').size() <= 200;
      allow delete: if isOwner();
    }
    match /members/{uid} {
      allow read: if signedIn();
      // The owner can always create or fix their own member profile.
      allow create, update: if isOwner() && uid == request.auth.uid;
      allow create: if signedIn() && uid == request.auth.uid && notBanned()
        && request.resource.data.nick is string && request.resource.data.nick.size() <= 24
        && request.resource.data.code == get(/databases/$(database)/documents/secret/invite).data.code
        && nameMine(request.resource.data.nick)
        && !(request.resource.data.get('dev', '') in cfg().get('bannedDevices', []));
      allow update: if signedIn() && uid == request.auth.uid && notBanned()
        && changed().hasOnly(['nick', 'color', 'lastSeen', 'away', 'nickAt', 'rulesOk', 'rulesAt', 'rulesSig'])
        && request.resource.data.nick.size() <= 24
        && (!changed().hasAny(['rulesOk', 'rulesAt', 'rulesSig']) || (request.resource.data.rulesOk is int && request.resource.data.rulesAt is int
            && request.resource.data.get('rulesSig', '') is string && request.resource.data.get('rulesSig', '').size() <= 200))
        && (!changed().hasAny(['nick']) || nameMine(request.resource.data.nick))
        && (!changed().hasAny(['nickAt']) || changed().hasAny(['nick']));
      allow delete: if isOwner()
        || (isAdmin() && uid != cfg().ownerUid && !(uid in cfg().get('admins', [])));
    }
    // Bio, status, name effect, banner, picture. Each person edits only their own.
    match /profiles/{uid} {
      allow read: if signedIn();
      allow create, update: if isMember() && uid == request.auth.uid
        && request.resource.data.keys().hasOnly(['bio', 'status', 'customStatus', 'nameFx', 'banner', 'avatar', 'deco', 'pfx', 'plate', 'pban', 'showcase'])
        && (!('showcase' in request.resource.data) || (request.resource.data.showcase is list && request.resource.data.showcase.size() <= 6))
        && request.resource.data.get('avatar', '').size() <= 120000
        && request.resource.data.get('bio', '').size() <= 190
        && request.resource.data.get('customStatus', '').size() <= 60;
      allow delete: if isOwner();
    }
    // Purchased perks. Only the owner can grant or remove them.
    match /perks/{uid} {
      allow read: if signedIn();
      allow write: if isOwner();
    }
    // Sparks wallet. Each person can only: start empty, buy at the catalog price with Sparks they have,
    // claim each quest once for its listed reward, and claim the daily reward once every 20 hours.
    // The owner can adjust any wallet (gifts, Spark packs bought with real money).
    match /wallet/{uid} {
      function cat() { return get(/databases/$(database)/documents/config/catalog).data; }
      function nw() { return request.resource.data; }
      function ow() { return resource.data; }
      function mine() { return isMember() && uid == request.auth.uid; }
      allow read: if signedIn();
      allow write: if isOwner();
      allow create: if mine()
        && nw().keys().hasOnly(['earned', 'spent', 'items', 'quests', 'lastDaily', 'lastItem', 'lastQuest'])
        && nw().earned == 0 && nw().spent == 0 && nw().items.size() == 0 && nw().quests.size() == 0 && nw().lastDaily == 0;
      // buy one item
      allow update: if mine()
        && changed().hasOnly(['spent', 'items', 'lastItem'])
        && nw().items.size() == ow().items.size() + 1
        && nw().items.toSet().difference(ow().items.toSet()) == [nw().lastItem].toSet()
        && nw().spent == ow().spent + cat().prices[nw().lastItem]
        && nw().spent <= ow().earned;
      // claim one quest (permanent catalog quest or today's daily quest)
      function todayEt() { return int((request.time.toMillis() - 18000000) / 86400000); }
      function dailyQuestReward(qid) {
        return qid == 'dq_' + string(todayEt()) + '_dq_chat5' ? 60
          : qid == 'dq_' + string(todayEt()) + '_dq_chat15' ? 100
          : qid == 'dq_' + string(todayEt()) + '_dq_react3' ? 50
          : qid == 'dq_' + string(todayEt()) + '_dq_react8' ? 80
          : qid == 'dq_' + string(todayEt()) + '_dq_reply2' ? 60
          : qid == 'dq_' + string(todayEt()) + '_dq_dm2' ? 60
          : qid == 'dq_' + string(todayEt()) + '_dq_gif1' ? 50
          : qid == 'dq_' + string(todayEt()) + '_dq_poll1' ? 50
          : qid == 'dq_' + string(todayEt()) + '_dq_vouch1' ? 90
          : qid == 'dq_' + string(todayEt()) + '_dq_game1' ? 75
          : -1;
      }
      allow update: if mine()
        && changed().hasOnly(['earned', 'quests', 'lastQuest'])
        && !(nw().lastQuest in ow().quests)
        && nw().quests.size() == ow().quests.size() + 1
        && nw().quests.hasAll(ow().quests)
        && nw().quests.toSet().difference(ow().quests.toSet()) == [nw().lastQuest].toSet()
        && ((nw().lastQuest in cat().quests && nw().earned == ow().earned + cat().quests[nw().lastQuest])
          || (dailyQuestReward(nw().lastQuest) > 0 && nw().earned == ow().earned + dailyQuestReward(nw().lastQuest)));
      // Weekly vouch rewards (week starts Monday 00:00 Eastern): the owner/devs approve a vouch first, then its author can
      // claim it — 1st claim of the week +200, 2nd +150, then nothing. Each vouch pays at most once.
      function week() { return int((request.time.toMillis() - 363600000) / 604800000); }
      function vouchMsg() { let p = nw().lastVouch.split('/'); return get(/databases/$(database)/documents/rooms/$(p[0])/msgs/$(p[1])).data; }
      allow update: if mine()
        && changed().hasOnly(['earned', 'vWeek', 'vCount', 'lastVouch', 'vPaid'])
        && nw().lastVouch is string && nw().lastVouch.split('/').size() == 2
        && nw().vPaid.toSet().difference(ow().get('vPaid', []).toSet()) == [nw().lastVouch].toSet()
        && nw().vPaid.size() == ow().get('vPaid', []).size() + 1
        && vouchMsg().uid == uid && ('vouch' in vouchMsg()) && vouchMsg().get('approved', false) == true
        && vouchMsg().ts >= request.time.toMillis() - 1209600000
        && nw().vWeek == week()
        && ((ow().get('vWeek', -1) != week() && nw().vCount == 1 && nw().earned == ow().earned + 200)
          || (ow().get('vWeek', -1) == week() && ow().get('vCount', 0) == 1 && nw().vCount == 2 && nw().earned == ow().earned + 150));
      // Feedback reward: +200 once per post of yours that the owner/devs marked Planned, In progress or Done.
      function fbPost() { return get(/databases/$(database)/documents/feedback/$(nw().lastFb)).data; }
      allow update: if mine()
        && changed().hasOnly(['earned', 'fbPaid', 'lastFb'])
        && nw().lastFb is string
        && nw().fbPaid.toSet().difference(ow().get('fbPaid', []).toSet()) == [nw().lastFb].toSet()
        && nw().fbPaid.size() == ow().get('fbPaid', []).size() + 1
        && fbPost().uid == uid && fbPost().status in ['planned', 'working', 'done']
        && nw().earned == ow().earned + 200;
      // daily reward
      // Streak: claiming again within 48 hours adds 1, otherwise it starts over at 1. Every 7th day in a row pays +150 extra.
      allow update: if mine()
        && changed().hasOnly(['earned', 'lastDaily', 'streak'])
        && nw().lastDaily >= ow().lastDaily + 72000000
        && nw().lastDaily <= request.time.toMillis() + 300000
        && nw().lastDaily >= request.time.toMillis() - 300000
        && nw().get('streak', 0) == (nw().lastDaily - ow().lastDaily <= 172800000 ? ow().get('streak', 0) + 1 : 1)
        && nw().earned == ow().earned + cat().daily + (nw().get('streak', 0) % 7 == 0 ? 150 : 0);
    }
    // Shop orders. Buyers create their own pending order; only the owner approves.
    match /orders/{orderId} {
      allow read: if isOwner() || (signedIn() && resource.data.uid == request.auth.uid);
      allow create: if isMember() && ownsNew() && request.resource.data.status == 'pending';
      allow update: if isOwner();
      allow delete: if isOwner() || (signedIn() && ownsOld() && resource.data.status == 'pending');
    }

    // ---------------- rooms
    match /rooms/{roomId} {
      function room() { return get(/databases/$(database)/documents/rooms/$(roomId)).data; }
      function roomOpen() { return !room().get('readonly', false); }
      // Private rooms: only the owner and the people on the room's allowed list get in.
      function inRoom() { return isMember() && (!room().get('private', false) || isOwner() || request.auth.uid in room().get('allowed', [])); }
      function roomAdmin() { return isAdmin() && inRoom(); }
      allow read: if isMember();
      // Only the owner can make a room private or change who is in it.
      // Only the owner and head developers can make or unmake announcement (read-only) rooms.
      allow create: if isOwner() || (isAdmin() && !request.resource.data.get('private', false) && (isHeadDev() || !request.resource.data.get('readonly', false)));
      allow update: if isOwner() || (isAdmin() && !resource.data.get('private', false) && !request.resource.data.get('private', false)
        && (isHeadDev() || request.resource.data.get('readonly', false) == resource.data.get('readonly', false)));
      allow delete: if isOwner() || (isAdmin() && !resource.data.get('private', false) && (isHeadDev() || !resource.data.get('readonly', false)));

      // Each vouch uses one "vouch try" (vouchQuota/{uid}.used, written in the same batch).
      function vouchTryOk(rid, mid) {
        let qp = /databases/$(database)/documents/vouchQuota/$(request.auth.uid);
        let after = getAfter(qp).data;
        let before = exists(qp) ? get(qp).data.get('used', 0) : 0;
        return after.used == before + 1 && after.used <= 4 + after.get('extra', 0) && after.lastMsg == rid + '/' + mid;
      }
      match /msgs/{msgId} {
        allow read: if inRoom();
        allow create: if inRoom() && ownsNew() && request.resource.data.text.size() <= 4000
          && (roomOpen() || isOwner() || isHeadDev()) && notTimedOut() && !nameLocked()
          && (room().get('type', 'text') != 'vouches' || ('vouch' in request.resource.data))
          && (!('vouch' in request.resource.data) || isOwner() || vouchTryOk(roomId, msgId))
          && (!('vouch' in request.resource.data) || isOwner() || request.resource.data.text.size() >= 40)
          && (!('vouch' in request.resource.data) || (request.resource.data.vouch.stars is int
              && request.resource.data.vouch.stars >= 1 && request.resource.data.vouch.stars <= 5
              && request.resource.data.vouch.to is string && request.resource.data.vouch.to != request.auth.uid
              && request.resource.data.ts is int && request.resource.data.ts <= request.time.toMillis() + 300000 && request.resource.data.ts >= request.time.toMillis() - 300000));
        // Authors edit their own text; admins pin.
        allow update: if inRoom() && ownsOld()
          && changed().hasOnly(['text', 'edited', 'editedAt', 'mentions'])
          && request.resource.data.text.size() <= 4000;
        allow update: if roomAdmin() && changed().hasOnly(['pinned', 'pinnedBy']);
        // Only the owner and head developers approve or reject vouches.
        allow update: if (isOwner() || isHeadDev()) && inRoom() && changed().hasOnly(['pinned', 'pinnedBy', 'approved', 'approvedBy', 'rejected']);
        allow delete: if roomAdmin() || (inRoom() && ownsOld());
      }
      match /reacts/{reactId} {
        allow read: if inRoom();
        allow create: if inRoom() && ownsNew();
        allow delete: if roomAdmin() || (inRoom() && ownsOld());
      }
      match /typing/{uid} {
        allow read: if inRoom();
        allow write: if inRoom() && uid == request.auth.uid;
      }
      // Voice: who's in the channel. You can only add/update/remove yourself; admins can disconnect people.
      match /voice/{uid} {
        allow read: if inRoom();
        allow create, update: if inRoom() && uid == request.auth.uid && notTimedOut();
        allow delete: if (signedIn() && uid == request.auth.uid) || roomAdmin();
      }
      // Voice connection setup messages between two people. Only sender and receiver can see them.
      match /signals/{sid} {
        allow read: if inRoom() && (resource.data.to == request.auth.uid || resource.data.from == request.auth.uid);
        allow create: if inRoom() && request.resource.data.from == request.auth.uid && notTimedOut();
        allow delete: if signedIn() && (resource.data.to == request.auth.uid || resource.data.from == request.auth.uid);
      }
    }

    // ---------------- group chats
    match /groups/{groupId} {
      // Look the group up by path, so this also works inside msgs/reacts/typing (where `resource` is the message).
      function inGroup() { return isMember() && request.auth.uid in get(/databases/$(database)/documents/groups/$(groupId)).data.users; }
      function okUsers() { return request.resource.data.users is list && request.auth.uid in request.resource.data.users
        && request.resource.data.users.size() >= 2 && request.resource.data.users.size() <= 50; }
      function okName() { return !('name' in request.resource.data) || (request.resource.data.name is string && request.resource.data.name.size() <= 40); }
      allow get: if isMember() && request.auth.uid in resource.data.users;
      allow list: if isMember() && request.auth.uid in resource.data.users;
      allow create: if isMember() && ownsNew() && okUsers() && okName();
      allow update: if isMember() && request.auth.uid in resource.data.users && okUsers() && okName() && request.resource.data.uid == resource.data.uid;
      match /msgs/{msgId} {
        allow read: if inGroup();
        allow create: if inGroup() && ownsNew() && request.resource.data.text.size() <= 4000 && !nameLocked() && notTimedOut();
        allow update: if inGroup() && ownsOld() && changed().hasOnly(['text', 'edited', 'editedAt', 'mentions']) && request.resource.data.text.size() <= 4000;
        allow update: if inGroup() && changed().hasOnly(['pinned', 'pinnedBy']);
        allow delete: if inGroup() && ownsOld();
      }
      match /reacts/{reactId} {
        allow read: if inGroup(); allow create: if inGroup() && ownsNew(); allow delete: if inGroup() && ownsOld();
      }
      match /typing/{uid} {
        allow read: if inGroup(); allow write: if inGroup() && uid == request.auth.uid;
      }
    }

    // ---------------- direct messages (only the two people in it)
    match /dms/{dmId} {
      function inDm() { return isMember() && request.auth.uid in dmId.split('_'); }
      allow get: if inDm();
      allow list: if isMember() && request.auth.uid in resource.data.users;
      allow create, update: if inDm() && request.resource.data.users == dmId.split('_');

      match /msgs/{msgId} {
        allow read: if inDm();
        // timed-out people can only DM the owner (to talk about it)
        allow create: if inDm() && ownsNew() && request.resource.data.text.size() <= 4000 && !nameLocked()
          && (notTimedOut() || cfg().ownerUid in dmId.split('_'));
        allow update: if inDm() && ownsOld()
          && changed().hasOnly(['text', 'edited', 'editedAt', 'mentions'])
          && request.resource.data.text.size() <= 4000;
        allow update: if inDm() && changed().hasOnly(['pinned', 'pinnedBy']);
        allow delete: if inDm() && ownsOld();
      }
      match /reacts/{reactId} {
        allow read: if inDm();
        allow create: if inDm() && ownsNew();
        allow delete: if inDm() && ownsOld();
      }
      match /typing/{uid} {
        allow read: if inDm();
        allow write: if inDm() && uid == request.auth.uid;
      }
    }

    // Unread / mention markers per room.
    match /meta/{roomId} {
      allow read: if isMember();
      allow write: if isMember();
    }

    // Shared GIF library.
    match /gifs/{gifId} {
      allow read: if isMember();
      allow create: if isMember() && ownsNew();
      allow delete: if isAdmin();
    }

    // Mini-game leaderboard scores. Each member writes only their own stats.
    match /gameScores/{uid} {
      function okScore(v) { return v is int && v >= 0 && v <= 1000000; }
      allow read: if isMember();
      allow create, update: if isMember() && uid == request.auth.uid
        && request.resource.data.keys().hasOnly(['uid', 'totalWins', 'wordle', 'bee', 'sudoku', 'crossword', 'flappyWins', 'flappyBest', 'updatedAt'])
        && request.resource.data.uid == request.auth.uid
        && okScore(request.resource.data.get('totalWins', 0))
        && okScore(request.resource.data.get('wordle', 0))
        && okScore(request.resource.data.get('bee', 0))
        && okScore(request.resource.data.get('sudoku', 0))
        && okScore(request.resource.data.get('crossword', 0))
        && okScore(request.resource.data.get('flappyWins', 0))
        && okScore(request.resource.data.get('flappyBest', 0))
        && request.resource.data.get('updatedAt', 0) is int;
      allow delete: if isOwner();
    }
  }
}
